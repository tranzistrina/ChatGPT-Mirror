# For docker-compose.lan.yml ONLY. Copy to .env.lan and customize.
# This LAN IP MUST belong to the server Mac's LAN interface (not 127.0.0.1).
LAN_BIND_IP=192.168.1.10
LAN_PORT=50002
# Comma-separated allowed Host header values; include your chosen LAN IP.
LAN_ALLOWED_HOSTS=192.168.1.10,localhost,127.0.0.1

# These values are generated with scripts/setup_lan_env.py; never reuse defaults.
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
TZ=UTC

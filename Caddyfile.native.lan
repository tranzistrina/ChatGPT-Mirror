# First-party gateway on macOS; set LAN_BIND_IP to this Mac's trusted LAN address.
http://{$LAN_BIND_IP}:50002 {
  @admin path /admin
  redir @admin /admin/ 308
  handle_path /admin/* {
    root * ./frontend/dist
    try_files {path} /index.html
    file_server
  }
  handle /0x/* {
    reverse_proxy 127.0.0.1:8000
  }
  handle {
    reverse_proxy 127.0.0.1:8787
  }
}

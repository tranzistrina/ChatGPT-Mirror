# Copy to .env.native, edit secrets, never commit the result.
DJANGO_ENV=PRODUCTION
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
ALLOW_REGISTER=false
SHOW_GITHUB=false
TZ=UTC
CHATGPT_GATEWAY_URL=http://127.0.0.1:8787
GATEWAY_UPSTREAM=127.0.0.1:8787
